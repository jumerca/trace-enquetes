{
  "name": "domaines-terroirs",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Domaines & Terroirs — gestion d'un territoire rural — JLG Creative",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.cjs",
    "icons": "node scripts/icons.cjs",
    "bake:sprites": "node scripts/bake-vehicles.cjs",
    "build:pages": "npm run build && rm -rf ../domaines-terroirs && cp -r dist ../domaines-terroirs"
  },
  "dependencies": {
    "pixi.js": "8.6.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "fake-indexeddb": "6.0.0",
    "three": "^0.170.0",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
