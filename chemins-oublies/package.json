    "build:pages": "npm run build && rm -rf ../chemins && cp -r dist ../chemins"
  },
  "dependencies": {
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sc": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
