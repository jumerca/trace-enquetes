{
  "name": "chemins-oublies",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Les Chemins Oubliés — Prologue : La Route effacée — JLG Creative",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
