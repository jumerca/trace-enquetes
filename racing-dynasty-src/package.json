{
  "name": "racing-dynasty",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Racing Dynasty — management d'écurie de monoplaces — JLG Creative",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.cjs",
    "icons": "node scripts/icons.cjs",
    "test:pwa": "node scripts/pwa-check.cjs",
    "build:pages": "npm run build && rm -rf ../racing-dynasty && cp -r dist ../racing-dynasty"
  },
  "dependencies": {
    "@fontsource/bangers": "5.2.5",
    "@fontsource/barlow-condensed": "5.2.5",
    "pixi.js": "8.6.6",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
